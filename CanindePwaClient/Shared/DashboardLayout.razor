@inherits LayoutComponentBase

@using CanindePwaClient.Auth
@using CanindePwaShared.Models.Dto.AuthDto
@using CanindePwaShared.Models.Dto.UserDto
@using Microsoft.AspNetCore.Components.Authorization

@inject UserContext UserContext
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            @if (UserContext != null && UserContext.IsLoaded)
            {
                <CascadingValue Name="CurrentUser" Value="UserContext.CurrentUser">
                    <CascadingValue Name="CurrentMenus" Value="UserContext.Menus">
                        <div class="curio-page">
                            <div class="curio-sidebar">
                                <SidebarDinamico
                                    Usuario="UserContext.CurrentUser"
                                    Menus="UserContext.Menus"
                                    OnLogout="HandleSidebarLogout" />
                            </div>
                            <div class="curio-main">
                                <article class="curio-content curio-px-4">
                                    @Body
                                </article>
                            </div>
                        </div>
                    </CascadingValue>
                </CascadingValue>
            }
            else
            {
                <div class="curio-loading-screen">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                </div>
            }
        </Authorized>

        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    @inject AuthManager AuthManager
    @inject UserContext UserContext
    @inject NavigationManager Navigation

    protected override async Task OnInitializedAsync()
    {
        if (!UserContext.IsLoaded)
            await UserContext.LoadAsync();
    }

    private async Task HandleSidebarLogout()
    {
        await AuthManager.LogoutAsync();   // limpa token, cookie, storage
        UserContext.Clear();               // limpa usuário e menus em memória

        Navigation.NavigateTo("/login", true); // força reload limpo
    }
}