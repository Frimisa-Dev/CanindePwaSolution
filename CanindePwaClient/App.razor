@* ============================================================
   App.razor
   ------------------------------------------------------------
   Arquivo CENTRAL de segurança do Blazor WASM.
   QUALQUER erro aqui quebra TODA a proteção do sistema.

   ⚠️ NUNCA remover:
   - CascadingAuthenticationState
   - AuthorizeRouteView
   - NotAuthorized / Authorizing
   - GuardaRota (acesso às páginas pelas tabelas perfis/rotas/menus)
   ============================================================ *@

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Reflection

@inject NavigationManager NavigationManager
@inject NavigationService NavigationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http

@* ============================================================
   🔐 CONTEXTO GLOBAL DE AUTENTICAÇÃO
   ------------------------------------------------------------
   ESSENCIAL.
   Sem isso o Blazor NÃO consulta o AuthenticationStateProvider
   e TODAS as páginas ficam abertas.
   ============================================================ *@
<CascadingAuthenticationState>

    @* ========================================================
       🚦 ROUTER PRINCIPAL DA APLICAÇÃO
       ======================================================== *@
    <Router AppAssembly="@typeof(Program).Assembly"
            AdditionalAssemblies="additionalAssemblies"
            OnNavigateAsync="OnNavigateAsync">

        @* ====================================================
           ✔️ ROTA ENCONTRADA
           ==================================================== *@
        <Found Context="routeData">

            @* ================================================
               🔐 ROUTE VIEW COM AUTORIZAÇÃO
               ------------------------------------------------
               - Respeita [Authorize]
               - Respeita roles e policies
               - Consulta CookieAuthStateProvider
               ================================================ *@
            @* ================================================
               🧭 GUARDA DE ROTA (perfis/rotas/menus)
               ------------------------------------------------
               Usuário logado só abre a página se a rota estiver
               no SEU menu (api/menu/porusuario). Mesma fonte da
               sidebar: se não aparece no menu, não abre digitando
               a URL. Rotas livres: /, /login, /validarpin,
               /recuperar-acesso, /dashboard.
               ================================================ *@
            <GuardaRota>
            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@typeof(MainLayout)">

                @* ============================================
                   ❌ NÃO AUTORIZADO
                   --------------------------------------------
                   Executado quando:
                   - Não existe cookie válido
                   - Sessão expirada
                   - Usuário não tem permissão
                   ============================================ *@
                <NotAuthorized Context="authContext">

                    @LogNotAuthorizedTelemetry()

                    @if (authContext.User.Identity?.IsAuthenticated == true)
                    {
                        @* LOGADO, mas sem permissão para esta página:
                           NÃO encerra a sessão (só quem perdeu a sessão vai ao login). *@
                        var pendentePin = authContext.User.HasClaim("IsActive", "False");

                        <div class="curio-card curio-p-4 curio-text-center"
                                style="border: 2px solid var(--curio-warning);">

                            <p class="curio-text-error"
                                style="font-size: var(--curio-font-size-xl);
                                        font-weight: 600;">
                                Acesso Negado
                            </p>

                            @if (pendentePin)
                            {
                                <p class="curio-mb-3">
                                    Conclua a validação do PIN para acessar o sistema.
                                </p>

                                <button class="curio-btn curio-btn--primary"
                                        @onclick="GoToValidarPin">
                                    Validar PIN
                                </button>
                            }
                            else
                            {
                                <p class="curio-mb-3">
                                    Você não tem permissão para acessar esta página.
                                </p>

                                <button class="curio-btn curio-btn--primary"
                                        @onclick="GoToDashboard">
                                    Voltar ao Dashboard
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="curio-card curio-p-4 curio-text-center"
                                style="border: 2px solid var(--curio-warning);">

                            <p class="curio-text-error"
                                style="font-size: var(--curio-font-size-xl);
                                        font-weight: 600;">
                                Acesso Negado
                            </p>

                            <p class="curio-mb-3">
                                Esta página requer autenticação válida.
                            </p>

                            <button class="curio-btn curio-btn--primary"
                                    @onclick="GoToLogin">
                                Ir para Login
                            </button>
                        </div>
                    }

                </NotAuthorized>

                @* ============================================
                   ⏳ AUTORIZANDO
                   --------------------------------------------
                   Exibido enquanto:
                   - CookieAuthStateProvider valida no backend
                   - /api/auth/profile está sendo consultado
                   ============================================ *@
                <Authorizing>
                    <div class="curio-text-center curio-p-5">
                        <div class="curio-spinner-modern"></div>
                        <p class="curio-mt-3">
                            Verificando autorização...
                        </p>
                    </div>
                </Authorizing>

            </AuthorizeRouteView>
            </GuardaRota>

            @* ================================================
               🎯 ACESSIBILIDADE / FOCO
               ================================================ *@
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />

        </Found>

        @* ====================================================
           ❓ ROTA NÃO ENCONTRADA (404)
           ==================================================== *@
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="curio-container curio-text-center
                            curio-mt-5 curio-p-4">

                    <h3 class="curio-text-warning"
                        style="color: var(--curio-warning);">
                        Página não encontrada (404)
                    </h3>

                    <p class="curio-mb-2">
                        <strong>URL:</strong> @NavigationManager.Uri
                    </p>

                    <p class="curio-text-muted curio-mb-4">
                        Esta URL não corresponde a nenhuma página registrada.
                    </p>

                    <div class="curio-flex curio-gap-3
                                curio-justify-center">

                        <button class="curio-btn curio-btn--primary"
                                @onclick="GoBack">
                            Voltar ao Menu
                        </button>

                        <button class="curio-btn curio-btn--secondary"
                                @onclick="GoToHome">
                            Ir para Home
                        </button>

                    </div>
                </div>
            </LayoutView>
        </NotFound>

    </Router>
</CascadingAuthenticationState>

@code {

    // =======================================================
    // 🔧 SUPORTE A ASSEMBLIES EXTERNAS (caso use módulos)
    // =======================================================
    private Assembly[] additionalAssemblies = Array.Empty<Assembly>();

    // =======================================================
    // 🚦 NAVEGAÇÃO ASSÍNCRONA
    // -------------------------------------------------------
    // Ponto futuro para:
    // - Auditoria
    // - Anti-tamper
    // - Detecção de navegação suspeita
    // =======================================================
    private async Task OnNavigateAsync(NavigationContext context)
    {
        await Task.CompletedTask;
    }

    // =======================================================
    // 🔁 AÇÕES DE NAVEGAÇÃO SEGURA
    // =======================================================
    private async Task GoToLogin()
    {
        try
        {
            // 🔐 REGRA BANCÁRIA:
            // Qualquer acesso negado encerra a sessão no backend
            await Http.PostAsync("/api/auth/logout", null);
        }
        catch
        {
            // ⚠️ Mesmo se falhar, seguimos para login
            // (não confiamos em estado parcial)
        }
    
        // 🔁 Navegação limpa, força reload completo
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    private void GoToHome()
        => NavigationManager.NavigateTo("/", forceLoad: true);

    // Logado sem permissão: volta ao Dashboard SEM encerrar a sessão
    private void GoToDashboard()
        => NavigationManager.NavigateTo("/dashboard");

    // Usuário pendente de PIN: segue para a validação (sem logout)
    private void GoToValidarPin()
        => NavigationManager.NavigateTo("/validarpin");

    private async Task GoBack()
    {
        if (NavigationService != null)
        {
            await NavigationService.GoBackToStartAsync();
        }
        else
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    // =======================================================
    // 📡 CONFERENCIA DE ACESSO NEGADO
    // -------------------------------------------------------
    // IMPORTANTE:
    // - NÃO altera estado
    // - NÃO navega
    // - Apenas registra
    // =======================================================
    private RenderFragment LogNotAuthorizedTelemetry() => builder =>
    {
        _ = LogAsync();
    };

    private async Task LogAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        // Aqui pode integrar:
        // - Logs de segurança
        // - Auditoria bancária
        // - SIEM
    }

    private bool IsPendingPinUser
    {
        get
        {
            var authStateTask = AuthenticationStateProvider.GetAuthenticationStateAsync();
            authStateTask.Wait();

            var user = authStateTask.Result.User;

            return user.Identity?.IsAuthenticated == true &&
                   user.HasClaim("IsActive", "False");
        }
    }

}
